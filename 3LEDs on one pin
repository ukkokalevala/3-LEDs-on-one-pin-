#define LED_PIN 9

void setup() {
  pinMode(LED_PIN, OUTPUT);
  Serial.begin(9600);
  Serial.println("Nano 3-LED Controller Ready!");
}

void loop() {
  // All LEDs blink together
  digitalWrite(LED_PIN, HIGH);
  Serial.println("ALL LEDs ON");
  delay(1000);
  
  digitalWrite(LED_PIN, LOW);
  Serial.println("ALL LEDs OFF");
  delay(1000);
}
